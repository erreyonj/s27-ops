# Copy to .env and fill in from your Supabase project (Settings -> API).
VITE_SUPABASE_URL=
# Use the publishable key (sb_publishable_...). The legacy anon key also works
# under VITE_SUPABASE_ANON_KEY. Both are browser-safe (protected by RLS).
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: only for the CLI `npm run seed`. The app can seed itself from the
# browser (sign in, then "Load starter recipes"), so this is usually unneeded.
SUPABASE_SERVICE_ROLE_KEY=
